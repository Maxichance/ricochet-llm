# One key per provider. A provider without a key is simply ignored (at least one key is required).
# Where to get the free keys: see README.md, or the dashboard ("key missing" card).
GROQ_API_KEY=
NVIDIANIM_API_KEY=
OLLAMACLOUD_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
GONKA_API_KEY=

# Web search through free APIs (optional, at least one key to enable `ricochet_llm.search`). Free tiers that renew,
# no card: Exa $10/month, Tavily 1,000 credits/month, LangSearch (tokens per day). See docs/WEB_SEARCH.md
EXA_API_KEY=
TAVILY_API_KEY=
LANGSEARCH_API_KEY=
# RICOCHET_SEARCH_ORDER=exa,tavily,langsearch
# RICOCHET_SEARCH_COUNTRY=france

# Optional: expiry date of a key (YYYY-MM-DD), shown in the dashboard with an alert 30 days before.
# (OpenRouter already provides its own automatically.)
NVIDIANIM_API_KEY_EXPIRES=

# Optional: your own code (tools + system prompt), see examples/demo_tools.py
# RICOCHET_PLUGIN=examples/demo_tools.py
# Optional: provider overrides file, see providers.example.json
# RICOCHET_PROVIDERS=providers.json
# Optional: providers to move to the front, without a file (unknown names ignored)
# RICOCHET_ORDER=groq,nvidia
