# Une clé par provider. Un provider sans clé est simplement ignoré (au moins une clé est requise).
# Où obtenir les clés gratuites : voir README.md, ou l'interface (carte « clé absente »).
GROQ_API_KEY=
NVIDIANIM_API_KEY=
OLLAMACLOUD_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
GONKA_API_KEY=

# Recherche Web par API gratuite (facultatif, au moins une clé pour activer `ricochet_llm.search`). Offres gratuites qui se
# renouvellent, sans carte : Exa 10 $/mois, Tavily 1 000 crédits/mois, LangSearch (jetons par jour). Voir docs/RECHERCHE_WEB.md
EXA_API_KEY=
TAVILY_API_KEY=
LANGSEARCH_API_KEY=
# RICOCHET_SEARCH_ORDER=exa,tavily,langsearch
# RICOCHET_SEARCH_COUNTRY=france

# Optionnel : date d'expiration d'une clé (AAAA-MM-JJ), affichée dans l'interface avec une alerte à J-30.
# (OpenRouter fournit déjà la sienne automatiquement.)
NVIDIANIM_API_KEY_EXPIRES=

# Optionnel : votre code métier (outils + prompt système), voir examples/demo_tools.py
# RICOCHET_PLUGIN=examples/demo_tools.py
# Optionnel : fichier de surcharge des providers, voir providers.example.json
# RICOCHET_PROVIDERS=providers.json
# Optionnel : providers à passer en tête, sans fichier (noms inconnus ignorés)
# RICOCHET_ORDER=groq,nvidia
